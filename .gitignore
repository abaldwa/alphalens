# .gitignore
#
# Specs: SPEC-SEC-001 (credentials never in VCS), SPEC-DS-007 (gitignored stores)

# SPEC-SEC-001: bare `.env` alone did NOT cover sidecars. A real
# `.env.bak_before_backup_enable_20260810_184856` holding 13 credential lines
# sat untracked in the repo root on 2026-08-11, one `git add -A` from being
# committed. Cover every .env sidecar (.bak, .local, .prod, dated copies) and
# re-include only the committed template.
.env
.env.*
!.env.example
*.db
*.duckdb
datastore/raw/
datastore/normalised/
datastore/features/
datastore/models/
datastore/signals/
datastore/logs/
__pycache__/
*.pyc
.venv/
catboost_info/
.pytest_cache/
.coverage

# Claude Code local tool settings/lock files (machine-specific, not project source)
.claude/

# FYERS SDK runtime logs (generated at runtime, not source)
fyersRequests.log
fyersApi.log

# Top-level runtime pipeline logs (generated at runtime, not source)
logs/
*.lock

# A25 rollback snapshots (generated, multi-GB, not source)
datastore/snapshots/

# Backtest DuckDB store (generated, multi-GB, not source)
datastore/backtest_store/

# Backtest orchestrator cache (generated parquet/log scratch, not source)
backtest/cache/

# Backtest job-output reports (generated JSON, 4.3GB+, not source)
backtest/reports/

# Pre-migration DuckDB snapshots (8.9GB) and restore scratch (3.3GB). These are
# point-in-time safety copies taken before backfills/schema changes, not source.
# Untracked and unignored until 2026-08-12, when a `git add -A` would have tried
# to commit 12.2GB of database files.
datastore/backups/
datastore/restore_staging/

# Sweep run artifacts written to the repo root by the backtest runners
# (scripts/run_priority_backtest.py, backtest/run_sweep_inprocess.py).
# Transient operator output, not source: logs are per-run and the queue
# JSONs are regenerated by --build-queue.
/supervisor.log
/tf_fast.log
/tf_final.log
/mom_fast.log
/mom_keys.log
/mom_signals.log
/mom_rankonly.log
/queue_prio.json
/queue_tf_fast.json
/queue_mom_rankonly.json
/fund2020.log
/queue_fund_2020.json
