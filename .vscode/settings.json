{
  "task.allowAutomaticTasks": true,
  "task.presentation.reveal": "silent",
  "contextSystem.project": "AlphaLens",
  "contextSystem.autoInject": true,
  "contextSystem.sessionStartHook": "context session start --auto",
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "datastore/raw",
    "datastore/normalised",
    "datastore/backtest_store",
    "datastore/features",
    "datastore/snapshots",
    "datastore/backups",
    "datastore/models",
    "datastore/signals",
    "datastore/restore_staging",
    "datastore/logs",
    "logs",
    "catboost_info",
    "frontend"
  ]
}