# .env.example
#
# Phase: 0
# Specs: SPEC-SEC-001
# Owner: Platform
# Consumers: config/settings.py
#
# Copy this file to .env and fill in real credentials.
# .env is gitignored — never commit real credentials (SPEC-SEC-001).
# config/settings.py loads these via os.environ.get() only.

FYERS_APP_ID=your_fyers_app_id_here
FYERS_SECRET_ID=your_fyers_secret_id_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here
FYERS_REDIRECT_URI=https://127.0.0.1

# Phase 2 (SPEC-PIPE-003): Screener.in Premium login, used by
# ingestion/scrapers/screener.py for quarterly fundamentals + shareholding
SCREENER_USERNAME=your_screener_in_username_here
SCREENER_PASSWORD=your_screener_in_password_here

# Phase 2.2 (SPEC-PIPE-003): ValueResearchOnline login, used by
# ingestion/scrapers/valueresearch_holdings.py for MF scheme portfolio holdings
VALUERESEARCH_USERNAME=your_valueresearchonline_username_here
VALUERESEARCH_PASSWORD=your_valueresearchonline_password_here

# Phase 2.6: Trendlyne StratQ login — superstar investor tracking, corporate actions
TRENDLYNE_USERNAME=your_trendlyne_username_here
TRENDLYNE_PASSWORD=your_trendlyne_password_here

# Phase 2.6: Tijori Finance Pro login — operational metrics, segment data
TIJORI_USERNAME=your_tijori_username_here
TIJORI_PASSWORD=your_tijori_password_here
